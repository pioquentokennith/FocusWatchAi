{
  "name": "ai-object-visualizer",
  "private": true,
  "version": "0.3.0",
  "description": "AI Object Visualizer — local face and eye reminders with background monitoring",
  "author": "AI Object Visualizer",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "prepare:ai": "node scripts/prepare-ai.mjs",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "predev": "npm run prepare:ai",
    "dev": "vite",
    "prebuild": "npm run prepare:ai",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop": "npm run build && npm run prepare:desktop && playwright test --config=playwright.desktop.config.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.2.2",
    "jsdom": "^26.1.0",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  }
}
